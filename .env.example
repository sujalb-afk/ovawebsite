# OVA Web backend (CMS-OVA API uses 5000 — do not use 5000 here)
PORT=5004

# Forms transfer API (forward submissions; separate from CMS content)
FORMS_TRANSFER_URL=https://your-ngrok-or-api-host.example
FORMS_TRANSFER_API_KEY=your_forms_transfer_key

# CMS-OVA published content (/api/public/* only — staff must click Publish)
OVA_CMS_API_URL=https://your-ngrok-or-cms-host.example
OVA_CMS_PUBLIC_API_KEY=ova_pub_demo_sk_8f3a2b1c9d4e5f6a7b8c9d0e1f2a3b4c
OVA_CMS_CONTENT_ENABLED=true
OVA_CMS_CONTENT_CACHE_SECONDS=10
# Fallback when ngrok is offline (local CMS-OVA npm run dev on :5000)
OVA_CMS_LOCAL_URL=http://localhost:5000
# Rewrite /uploads/* image URLs in API responses (usually same host as OVA_CMS_API_URL)
OVA_CMS_ASSET_URL=https://your-ngrok-or-cms-host.example

# client/.env.development (gitignored) — Vite proxies /api to OVA Web only
# VITE_API_PROXY_TARGET=http://localhost:5004
# VITE_OVA_CMS_ASSET_URL=http://localhost:5000

# MongoDB, SMTP, Razorpay, reCAPTCHA — see existing server/.env
