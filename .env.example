# OVA Web backend (CMS-OVA API uses 5000 — do not use 5000 here)
PORT=5004
# Cloud MongoDB (no local install). Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ova_db?retryWrites=true&w=majority
# Or remote server on your host:
# MONGODB_HOST=your-server-ip-or-cluster.mongodb.net
# MONGODB_USER=adminOrelse
# MONGODB_PASS=your-password
# MONGODB_DB=ova_db

# Forms transfer API (forward submissions to another site; use same PORT as ngrok tunnel)
FORMS_TRANSFER_URL=https://larry-epicentral-boldfacedly.ngrok-free.dev
FORMS_TRANSFER_API_KEY=2u03dsnio30dkd393jd30hnkj233

# CMS-OVA public content API (page copy, events list, services — separate from /api/forms/*)
# Use the same HTTPS host as your running CMS API (localhost:5000 or ngrok tunnel to CMS server).
OVA_CMS_API_URL=https://larry-epicentral-boldfacedly.ngrok-free.dev
OVA_CMS_CONTENT_ENABLED=true
OVA_CMS_CONTENT_CACHE_SECONDS=10
# Optional: when ngrok is down, OVA Web tries this in development (CMS on :5000)
# OVA_CMS_LOCAL_URL=http://localhost:5000

# client/.env.development — proxy to OVA Web API only (never ngrok / never :5000)
# VITE_API_PROXY_TARGET=http://localhost:5004

# reCAPTCHA v2 (Contact, Donate, Join). In Google reCAPTCHA admin, add domains: localhost, ova.ngo, www.ova.ngo (not www.ova.ngo.com or paths).
# Site key is public (frontend); secret key is backend-only – set in server/.env, never in frontend code.
REACT_APP_RECAPTCHA_SITE_KEY=6LdpmIUsAAAAAFjnXdOOSY5wDXZelXs0RD4EZ-uh
RECAPTCHA_SECRET_KEY=6LdpmIUsAAAAANXLKQflRMW0MsJccZMDrxj7wbF_

